{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wein-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wein",
      "database_id": "a3173162-abea-46da-9016-6e9989d62cf2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "wein-photos"
    }
  ]
}
