<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Force light regardless of the phone's dark-mode setting: the map is light,
         so the UI must stay light to remain readable. -->
    <style name="Theme.Wein" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorSurface">@color/paper</item>
        <!-- Kill Material3's elevation surface tint so cards stay pure white, not pink -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="SheetShape">
        <item name="cornerSizeTopLeft">26dp</item>
        <item name="cornerSizeTopRight">26dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
